---
import { Icon } from "astro-icon/components";

const socialLinks = [
	{
		label: "GitHub",
		link: "https://github.com/maksymilan",
		icon: "mdi:github",
	},
	{
		label: "Google Scholar",
		link: "https://scholar.google.co.uk/citations?user=Komsf1YAAAAJ&hl=en",
		icon: "fa6-brands:google-scholar",
	},
];
---

<ul aria-label="社交链接" class="flex flex-wrap items-center gap-2">
	{
		socialLinks.map(({ label, link, icon }) => (
			<li>
				<a
					class="inline-flex h-9 items-center gap-2 rounded-xl border border-color-100 bg-special-light px-3 text-sm font-medium text-accent-base transition-colors hover:border-accent-two/30 hover:text-accent-two"
					href={link}
					rel="noreferrer"
					target="_blank"
				>
					<Icon aria-hidden="true" class="h-4 w-4" focusable="false" name={icon} />
					<span>{label}</span>
				</a>
			</li>
		))
	}
</ul>
