---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { menuLinks, siteConfig } from "@/site.config";

const pathname = Astro.url.pathname;
const isActive = (path: string) => (path === "/" ? pathname === "/" : pathname.startsWith(path));
---

<header class="sticky top-0 z-40 -mx-5 border-b border-color-100 bg-bgColor/90 px-5 backdrop-blur-xl sm:-mx-8 sm:px-8">
	<div class="mx-auto flex h-16 max-w-5xl items-center gap-3">
		<a
			aria-current={pathname === "/" ? "page" : undefined}
			aria-label={`${siteConfig.title} 首页`}
			class="group flex min-w-0 items-center gap-2.5 font-semibold text-accent-base"
			href="/"
		>
			<span class="grid h-8 w-8 shrink-0 place-items-center rounded-xl bg-accent-base text-sm font-bold text-bgColor shadow-sm transition-transform group-hover:-rotate-3">M</span>
			<span class="hidden truncate text-lg sm:block">{siteConfig.title}</span>
		</a>

		<nav aria-label="主导航" class="ml-auto flex items-center gap-1 sm:gap-2">
			{
				menuLinks.map((link) => (
					<a
						aria-current={isActive(link.path) ? "page" : undefined}
						class:list={[
							"rounded-lg px-2.5 py-1.5 text-sm font-medium transition-colors sm:px-3",
							isActive(link.path)
								? "bg-color-100 text-accent-base"
								: "text-lighter hover:bg-color-75 hover:text-accent-base",
						]}
						data-astro-prefetch
						href={link.path}
					>
						{link.title}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-1 border-l border-color-100 pl-2 sm:pl-3">
			<ThemeToggle />
		</div>
	</div>
</header>
