---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import { Icon } from "astro-icon/components";

interface Props {
	content: CollectionEntry<"post">;
}

const { content } = Astro.props;
---

<header class="border-b border-color-100 pb-8">
	{content.data.draft && <p class="mb-3 text-sm font-semibold text-red-500">草稿</p>}
	<h1 class="max-w-3xl text-3xl font-bold leading-tight tracking-tight text-accent-base sm:text-4xl" data-pagefind-body>
		{content.data.title}
	</h1>
	<div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-lighter">
		<span class="inline-flex items-center gap-1.5">
			<Icon aria-hidden="true" class="h-4 w-4" focusable="false" name="hugeicons:calendar-03" />
			<FormattedDate
				date={content.data.publishDate}
				dateTimeOptions={{ year: "numeric", month: "long", day: "2-digit" }}
			/>
		</span>
		<span class="inline-flex items-center gap-1.5">
			<Icon aria-hidden="true" class="h-4 w-4" focusable="false" name="hugeicons:book-open-01" />
			{/* @ts-ignore readingTime is added by the remark plugin */}
			{content.rendered?.metadata?.frontmatter?.readingTime ?? "少于 1 分钟"}
		</span>
		{
			content.data.updatedDate && (
				<span class="rounded-full bg-accent-two/5 px-2.5 py-1 text-xs text-accent-two">
					更新于 <FormattedDate date={content.data.updatedDate} />
				</span>
			)
		}
	</div>

	<p class="mt-5 max-w-3xl text-base leading-7 text-textColor" data-pagefind-body>{content.data.description}</p>

	{
		content.data.coverImage && (
			<div class="mt-6 overflow-hidden rounded-2xl border border-color-100">
				<Image
					alt={content.data.coverImage.alt}
					class="h-auto w-full object-cover"
					fetchpriority="high"
					src={content.data.coverImage.src}
				/>
			</div>
		)
	}
</header>
