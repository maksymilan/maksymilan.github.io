---
interface Props {
	type: "internship" | "education";
	logo: string;
	title: string;
	role: string;
	time: string;
	link?: string;
}

const { type, logo, title, role, time, link } = Astro.props;
const Tag = link ? "a" : "div";
const tagProps = link ? { href: link, target: "_blank", rel: "noopener noreferrer" } : {};
const accentClass = type === "internship" ? "bg-blue-500" : "bg-amber-500";
---

<Tag
	{...tagProps}
	class:list={[
		"relative flex items-start gap-4 rounded-2xl border border-color-100 bg-special-light p-4",
		link && "transition-colors hover:border-accent-two/30",
	]}
>
	<span aria-hidden="true" class:list={["absolute left-0 top-6 h-8 w-1 rounded-r-full", accentClass]}></span>
	<div class="grid h-12 w-12 shrink-0 place-items-center rounded-xl border border-color-100 bg-white p-2 shadow-sm dark:bg-gray-800">
		<img alt="" class="h-8 w-8 object-contain" height="32" loading="lazy" src={logo} width="32" />
	</div>
	<div class="min-w-0 flex-1">
		<div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
			<h3 class="text-base font-semibold leading-snug text-accent-base">{title}</h3>
			<span class="shrink-0 text-xs font-medium text-lighter">{time}</span>
		</div>
		<p class="mt-1 text-sm leading-relaxed text-lighter">{role}</p>
	</div>
</Tag>
