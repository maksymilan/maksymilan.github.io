---
interface Props {
	src: string;
	alt?: string;
	class?: string;
}

const { src, alt = "Maksymilan 的头像", class: extraClass } = Astro.props;
---

<img
	alt={alt}
	class:list={[
		"aspect-square rounded-[2rem] border border-color-100 object-cover shadow-[0_24px_70px_rgba(15,23,42,0.14)]",
		extraClass,
	]}
	decoding="async"
	fetchpriority="high"
	height="256"
	src={src}
	width="256"
/>
