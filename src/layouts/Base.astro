---
import BaseHead from "@/components/BaseHead.astro";
import SkipLink from "@/components/SkipLink.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
}

const {
	meta: { articleDate, description = siteConfig.description, ogImage, title },
} = Astro.props;
---

<html class="overflow-x-hidden scroll-smooth font-sans text-textColor antialiased" lang={siteConfig.lang}>
	<head>
		<BaseHead articleDate={articleDate} description={description} ogImage={ogImage} title={title} />
	</head>
	<body class="relative min-h-screen w-full bg-bgColor text-base">
		<ThemeProvider />
		<SkipLink />

		<div aria-hidden="true" class="site-ambient"></div>
		<div class="relative flex min-h-screen w-full">
			<slot name="sidebar" />
			<div id="container" class="mx-auto flex min-h-screen w-full max-w-5xl flex-1 flex-col px-5 sm:px-8">
				<Header />
				<main id="main" class="relative flex-1 py-10 sm:py-14 lg:py-16">
					<slot />
				</main>
				<Footer />
			</div>
		</div>
	</body>
</html>
